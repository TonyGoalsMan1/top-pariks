Port 2222
HostKey /etc/wordpress-factory/ssh_host_ed25519_key
AllowUsers factory-deploy
AuthorizedKeysFile /etc/wordpress-factory/deploy.keys
AuthenticationMethods publickey
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PermitEmptyPasswords no
UsePAM no
StrictModes yes
DisableForwarding yes
PermitTTY no
PermitUserRC no
PermitUserEnvironment no
ForceCommand /usr/local/libexec/wordpress-factory-receive
LoginGraceTime 20
MaxAuthTries 3
MaxSessions 1
